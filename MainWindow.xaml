<Window x:Class="Mp3TagFree.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:converters="clr-namespace:Mp3TagFree.Converters"
        mc:Ignorable="d"
        Title="Mp3 Tag Free - Premium Audio Metadata Editor" 
        Height="700" Width="1100"
        MinHeight="600" MinWidth="900"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:ThemeManager.RequestedTheme="Default"
        Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.Resources>
        <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter" />
        <converters:BoolToDirtyStringConverter x:Key="BoolToDirtyStringConverter" />
        <converters:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Custom Style for Dirty bullet in DataGrid -->
        <Style x:Key="DirtyBulletStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF7630C" /> <!-- Orange color for unsaved -->
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header & Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar Section -->
        <Border Grid.Row="0" 
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}" 
                BorderBrush="{DynamicResource SystemControlCornerConeOuterBorderBrush}" 
                BorderThickness="0,0,0,1" 
                Padding="8,4">
            <DockPanel LastChildFill="False">
                <!-- Add File Button -->
                <Button Content="파일 추가" 
                        Command="{Binding OpenFilesCommand}"
                        Style="{DynamicResource AccentButtonStyle}"
                        ui:ControlHelper.CornerRadius="4"
                        Padding="10,4"
                        Margin="0,0,6,0">
                    <Button.ToolTip>
                        <ToolTip Content="편집할 오디오 파일을 목록에 추가합니다." />
                    </Button.ToolTip>
                </Button>

                <!-- Add Folder Button -->
                <Button Content="폴더 추가" 
                        Command="{Binding OpenFolderCommand}"
                        ui:ControlHelper.CornerRadius="4"
                        Padding="10,4"
                        Margin="0,0,12,0">
                    <Button.ToolTip>
                        <ToolTip Content="폴더 및 하위 폴더의 모든 오디오 파일을 가져옵니다." />
                    </Button.ToolTip>
                </Button>

                <Separator Margin="0,0,12,0" />

                <!-- Remove Selected -->
                <Button Content="선택 항목 제거" 
                        Command="{Binding RemoveSelectedCommand}"
                        IsEnabled="{Binding IsAnySelected}"
                        ui:ControlHelper.CornerRadius="4"
                        Padding="10,4"
                        Margin="0,0,6,0" />

                <!-- Rename Files -->
                <Button Content="파일명 변경..." 
                        Command="{Binding RenameFilesCommand}"
                        IsEnabled="{Binding IsAnySelected}"
                        ui:ControlHelper.CornerRadius="4"
                        Padding="10,4"
                        Margin="0,0,6,0">
                    <Button.ToolTip>
                        <ToolTip Content="선택한 파일들의 이름을 패턴에 따라 일괄 변경합니다." />
                    </Button.ToolTip>
                </Button>

                <!-- Clear List -->
                <Button Content="목록 비우기" 
                        Command="{Binding ClearListCommand}"
                        ui:ControlHelper.CornerRadius="4"
                        Padding="10,4"
                        Margin="0,0,0,0" />

                <!-- Save Button (Right aligned) -->
                <Button Content="변경 사항 저장" 
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsAnySelected}"
                        Style="{DynamicResource AccentButtonStyle}"
                        ui:ControlHelper.CornerRadius="4"
                        DockPanel.Dock="Right"
                        Padding="12,4">
                    <Button.ToolTip>
                        <ToolTip Content="선택한 파일들의 태그 변경 내용을 디스크에 저장합니다." />
                    </Button.ToolTip>
                </Button>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="6">
            <Grid.ColumnDefinitions>
                <!-- File list -->
                <ColumnDefinition Width="2.5*" />
                <!-- Splitter -->
                <ColumnDefinition Width="Auto" />
                <!-- Tag Form Editor -->
                <ColumnDefinition Width="1*" MinWidth="320" MaxWidth="500" />
            </Grid.ColumnDefinitions>

            <!-- File List Panel -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}" 
                    CornerRadius="8" 
                    Padding="1" 
                    BorderThickness="1" 
                    BorderBrush="{DynamicResource SystemControlCornerConeOuterBorderBrush}">
                <Grid>
                    <!-- Drag and Drop Overlay Hint when list is empty -->
                    <StackPanel VerticalAlignment="Center" 
                                HorizontalAlignment="Center" 
                                Visibility="{Binding Files.Count, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                        <TextBlock Text="" 
                                   FontFamily="Segoe MDL2 Assets" 
                                   FontSize="48" 
                                   HorizontalAlignment="Center" 
                                   Foreground="{DynamicResource SystemControlDescriptionTextForegroundBrush}" 
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="여기에 오디오 파일이나 폴더를 드래그하거나" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" 
                                   Foreground="{DynamicResource SystemControlDescriptionTextForegroundBrush}" />
                        <TextBlock Text="상단의 추가 버튼을 클릭해 주세요." 
                                   FontSize="13" 
                                   HorizontalAlignment="Center" 
                                   Foreground="{DynamicResource SystemControlDescriptionTextForegroundBrush}" 
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Data Grid of Files -->
                    <DataGrid x:Name="FilesDataGrid"
                              ItemsSource="{Binding Files}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              SelectionChanged="FilesDataGrid_SelectionChanged"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="Transparent"
                              RowBackground="Transparent"
                              AlternatingRowBackground="Transparent"
                              Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                              HorizontalGridLinesBrush="{DynamicResource SystemControlCardStrokeColorDefaultBrush}"
                              BorderThickness="0"
                              RowHeight="25"
                              FontSize="12"
                              Visibility="{Binding Files.Count, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListMediumBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <!-- Unsaved modification bullet column -->
                            <DataGridTemplateColumn Width="35" Header="변경">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding IsDirty, Converter={StaticResource BoolToDirtyStringConverter}}" 
                                                   Style="{StaticResource DirtyBulletStyle}" 
                                                   ToolTip="저장되지 않은 변경 사항이 있습니다." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="파일명" Binding="{Binding FileName}" Width="150" />
                            <DataGridTextColumn Header="제목" Binding="{Binding Title}" Width="150" />
                            <DataGridTextColumn Header="아티스트" Binding="{Binding Artist}" Width="120" />
                            <DataGridTextColumn Header="앨범" Binding="{Binding Album}" Width="120" />
                            <DataGridTextColumn Header="연도" Binding="{Binding Year, TargetNullValue=''}" Width="60" />
                            <DataGridTextColumn Header="장르" Binding="{Binding Genre}" Width="100" />
                            <DataGridTextColumn Header="길이" Binding="{Binding Duration}" Width="70" />
                            <DataGridTextColumn Header="크기" Binding="{Binding FileSizeFormatted}" Width="90" />
                            <DataGridTextColumn Header="파일 경로" Binding="{Binding FilePath}" Width="250" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Stretch" 
                          Width="6" 
                          Background="Transparent" />

            <!-- Tag Form Editor Panel (Right Side) -->
            <Border Grid.Column="2" 
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}" 
                    CornerRadius="8" 
                    Padding="16" 
                    BorderThickness="1" 
                    BorderBrush="{DynamicResource SystemControlCornerConeOuterBorderBrush}">
                <Grid>
                    <!-- Displayed when nothing is selected -->
                    <StackPanel VerticalAlignment="Center" 
                                HorizontalAlignment="Center" 
                                Visibility="{Binding IsAnySelected, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                        <TextBlock Text="" 
                                   FontFamily="Segoe MDL2 Assets" 
                                   FontSize="40" 
                                   HorizontalAlignment="Center" 
                                   Foreground="{DynamicResource SystemControlDescriptionTextForegroundBrush}" 
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="편집할 오디오 파일을 선택하세요." 
                                   FontSize="14" 
                                   HorizontalAlignment="Center" 
                                   Foreground="{DynamicResource SystemControlDescriptionTextForegroundBrush}" />
                    </StackPanel>

                    <!-- Editor Fields -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                  Visibility="{Binding IsAnySelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ui:SimpleStackPanel Spacing="8">
                            <TextBlock Text="메타데이터 편집" 
                                       FontSize="16" 
                                       FontWeight="Bold" 
                                       Margin="0,0,0,2" />

                            <!-- Album Art Box with Drag-and-Drop capability -->
                            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,4">
                                <Border BorderThickness="1" 
                                        BorderBrush="{DynamicResource SystemControlCornerConeOuterBorderBrush}" 
                                        CornerRadius="8" 
                                        Width="120" Height="120" 
                                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" 
                                        AllowDrop="True"
                                        DragOver="AlbumArt_DragOver"
                                        Drop="AlbumArt_Drop"
                                        ToolTip="이 영역에 이미지 파일을 드래그하여 드롭하면 앨범 아트를 교체할 수 있습니다.">
                                    <Grid>
                                        <!-- Placeholder when no image -->
                                        <StackPanel VerticalAlignment="Center" 
                                                    HorizontalAlignment="Center" 
                                                    Visibility="{Binding AlbumArtInput, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                            <TextBlock Text="" 
                                                       FontFamily="Segoe MDL2 Assets" 
                                                       FontSize="28" 
                                                       HorizontalAlignment="Center" 
                                                       Foreground="{DynamicResource SystemControlDescriptionTextForegroundBrush}" />
                                            <TextBlock Text="이미지 드래그/드롭" 
                                                       FontSize="10" 
                                                       HorizontalAlignment="Center" 
                                                       Foreground="{DynamicResource SystemControlDescriptionTextForegroundBrush}" 
                                                       Margin="0,4,0,0" />
                                        </StackPanel>

                                        <!-- Actual Album Art Image -->
                                        <Image Source="{Binding AlbumArtInput, Converter={StaticResource ByteArrayToImageConverter}}" 
                                               Stretch="UniformToFill" />
                                    </Grid>
                                </Border>

                                <!-- Album Art Buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                    <Button Content="변경..." 
                                            Command="{Binding ChangeAlbumArtCommand}" 
                                            Margin="0,0,6,0"
                                            ui:ControlHelper.CornerRadius="4"
                                            Padding="10,4"
                                            FontSize="11" />
                                    <Button Content="삭제" 
                                            Command="{Binding RemoveAlbumArtCommand}"
                                            IsEnabled="{Binding AlbumArtInput, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            ui:ControlHelper.CornerRadius="4"
                                            Padding="10,4"
                                            FontSize="11" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Title Input -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="제목" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" />
                                <TextBox Grid.Column="1" Text="{Binding TitleInput, UpdateSourceTrigger=PropertyChanged}" 
                                         ui:ControlHelper.PlaceholderText="곡 제목 입력"
                                         ui:ControlHelper.CornerRadius="4" />
                            </Grid>

                            <!-- Artist Input -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="아티스트" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" />
                                <TextBox Grid.Column="1" Text="{Binding ArtistInput, UpdateSourceTrigger=PropertyChanged}" 
                                         ui:ControlHelper.PlaceholderText="아티스트명 입력"
                                         ui:ControlHelper.CornerRadius="4" />
                            </Grid>

                            <!-- Album Input -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="앨범" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" />
                                <TextBox Grid.Column="1" Text="{Binding AlbumInput, UpdateSourceTrigger=PropertyChanged}" 
                                         ui:ControlHelper.PlaceholderText="앨범명 입력"
                                         ui:ControlHelper.CornerRadius="4" />
                            </Grid>

                            <!-- Two Columns: Year & Track -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="45" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="발매 연도" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" />
                                <TextBox Grid.Column="1" Text="{Binding YearInput, UpdateSourceTrigger=PropertyChanged}" 
                                         ui:ControlHelper.PlaceholderText="예: 2026"
                                         ui:ControlHelper.CornerRadius="4" />

                                <TextBlock Grid.Column="3" Text="트랙" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" FontWeight="SemiBold" FontSize="12" />
                                <TextBox Grid.Column="4" Text="{Binding TrackInput, UpdateSourceTrigger=PropertyChanged}" 
                                         ui:ControlHelper.PlaceholderText="예: 1"
                                         ui:ControlHelper.CornerRadius="4" />
                            </Grid>

                            <!-- Genre Input -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="장르" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" />
                                <TextBox Grid.Column="1" Text="{Binding GenreInput, UpdateSourceTrigger=PropertyChanged}" 
                                         ui:ControlHelper.PlaceholderText="장르명 입력"
                                         ui:ControlHelper.CornerRadius="4" />
                            </Grid>

                            <!-- Lyrics Input -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="가사" VerticalAlignment="Top" Margin="0,4,0,0" FontWeight="SemiBold" FontSize="12" />
                                <TextBox Grid.Column="1" Text="{Binding LyricsInput, UpdateSourceTrigger=PropertyChanged}" 
                                         AcceptsReturn="True" 
                                         Height="80" 
                                         VerticalScrollBarVisibility="Auto" 
                                         TextWrapping="Wrap"
                                         ui:ControlHelper.PlaceholderText="여기에 가사를 입력하세요."
                                         ui:ControlHelper.CornerRadius="4" />
                            </Grid>
                        </ui:SimpleStackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Padding="12,3" Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}">
            <StatusBarItem DockPanel.Dock="Left">
                <TextBlock Text="{Binding SelectionStatusText}" FontSize="12" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right" HorizontalAlignment="Right" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <ui:ProgressRing IsActive="True" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LoadingStatus}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
